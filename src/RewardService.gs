function listRewards(adminToken){try{requireSession_(adminToken,['ADMIN','SUPERADMIN']);const users=readTable_('Users').reduce((map,item)=>{map[item.UserID]=item;return map;},{}),winners=readTable_('Winners').reduce((map,item)=>{map[item.WinnerID]=item;return map;},{});return apiSuccess_({rewards:readTable_('Rewards').map(item=>{const winner=winners[item.WinnerID]||{},user=users[winner.UserID]||{};return Object.assign({},item,{WinnerName:user.Name||''});})});}catch(error){return apiError_(error.message,error.publicCode||'REWARDS_FAILED');}}

function createRewardForWinner(adminToken,winnerId,payload){try{const admin=requireSession_(adminToken,['ADMIN','SUPERADMIN']),id=sanitizeText_(winnerId,40),winner=findOne_('Winners','WinnerID',id);if(!winner||winner.SelectionStatus!=='VALIDATED')return apiError_('Pemenang tervalidasi tidak ditemukan.','WINNER_NOT_FOUND');if(readTable_('Rewards').some(item=>item.WinnerID===id))return apiError_('Reward untuk pemenang sudah dibuat.','REWARD_EXISTS');const user=findOne_('Users','UserID',winner.UserID),data=payload||{},name=sanitizeText_(data.name||winner.Reward,150),nominal=Number(data.nominal),provider=sanitizeText_(data.provider,50);if(!name||!Number.isFinite(nominal)||nominal<0)return apiError_('Data reward tidak valid.','VALIDATION_ERROR');const rewardId=generateId_('Rewards'),timestamp=nowIso_();appendRecords_('Rewards',[{RewardID:rewardId,SeasonID:winner.SeasonID,NamaReward:name,Nominal:nominal,WinnerID:id,NomorTujuan:user?user.WhatsApp:'',Provider:provider,Status:'WAITING',TanggalKirim:'',Catatan:'',CreatedAt:timestamp,UpdatedAt:timestamp}]);logActivity_(admin.user.UserID,'ADMIN_UPDATE','Rewards',rewardId,'Membuat reward pemenang','');return apiSuccess_({rewardId:rewardId},'Reward berhasil dibuat.');}catch(error){return apiError_(error.message,error.publicCode||'REWARD_CREATE_FAILED');}}

function updateRewardStatus(adminToken,rewardId,status,note){try{const admin=requireSession_(adminToken,['ADMIN','SUPERADMIN']),id=sanitizeText_(rewardId,40),value=sanitizeText_(status,20).toUpperCase(),record=findOne_('Rewards','RewardID',id);if(!record)return apiError_('Reward tidak ditemukan.','REWARD_NOT_FOUND');if(['WAITING','VERIFIED','SENT','COMPLETED'].indexOf(value)<0)return apiError_('Status reward tidak valid.','VALIDATION_ERROR');const timestamp=nowIso_();updateRecord_('Rewards','RewardID',id,{Status:value,TanggalKirim:['SENT','COMPLETED'].indexOf(value)>=0?(record.TanggalKirim||timestamp):record.TanggalKirim,Catatan:sanitizeText_(note,500),UpdatedAt:timestamp});updateRecord_('Winners','WinnerID',record.WinnerID,{StatusReward:value});CacheService.getScriptCache().remove('publicWinners');logActivity_(admin.user.UserID,'ADMIN_UPDATE','Rewards',id,'Status reward menjadi '+value,'');return apiSuccess_({},'Status reward diperbarui.');}catch(error){return apiError_(error.message,error.publicCode||'REWARD_UPDATE_FAILED');}}
