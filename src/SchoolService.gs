function validateSchool_(payload){const data=payload||{},clean={name:sanitizeText_(data.name,150),npsn:sanitizeText_(data.npsn,20),type:sanitizeText_(data.type,30).toUpperCase(),address:sanitizeText_(data.address,500),district:sanitizeText_(data.district,100),status:sanitizeText_(data.status||'ACTIVE',20).toUpperCase()},errors=[];if(clean.name.length<4)errors.push('Nama sekolah minimal 4 karakter.');if(clean.npsn&&!/^\d{8}$/.test(clean.npsn))errors.push('NPSN harus 8 digit.');if(!clean.type)errors.push('Jenis sekolah wajib diisi.');if(!clean.district)errors.push('Kecamatan wajib diisi.');if(['ACTIVE','INACTIVE'].indexOf(clean.status)<0)errors.push('Status sekolah tidak valid.');return {valid:!errors.length,errors:errors,data:clean};}

function listAdminSchools(adminToken){try{requireSession_(adminToken,['ADMIN','SUPERADMIN']);return apiSuccess_({schools:readTable_('Schools').sort((a,b)=>String(a.NamaSekolah).localeCompare(String(b.NamaSekolah)))});}catch(error){return apiError_(error.message,error.publicCode||'SCHOOLS_FAILED');}}

function createSchool(adminToken,payload){try{const admin=requireSession_(adminToken,['ADMIN','SUPERADMIN']),result=validateSchool_(payload);if(!result.valid)return apiError_(result.errors[0],'VALIDATION_ERROR');return withDocumentLock_(function(){const rows=readTable_('Schools'),data=result.data;if(data.npsn&&rows.some(item=>String(item.NPSN)===data.npsn))return apiError_('NPSN sudah terdaftar.','DUPLICATE_NPSN');const id=generateId_('Schools'),timestamp=nowIso_();appendRecords_('Schools',[{SchoolID:id,NamaSekolah:data.name,NPSN:data.npsn,Jenis:data.type,Alamat:data.address,Kecamatan:data.district,Status:data.status,CreatedAt:timestamp,UpdatedAt:timestamp}]);logActivity_(admin.user.UserID,'ADMIN_UPDATE','Schools',id,'Membuat sekolah','');return apiSuccess_({schoolId:id},'Sekolah berhasil dibuat.');});}catch(error){return apiError_(error.message,error.publicCode||'SCHOOL_CREATE_FAILED');}}

function updateSchool(adminToken,schoolId,payload){try{const admin=requireSession_(adminToken,['ADMIN','SUPERADMIN']),id=sanitizeText_(schoolId,40),existing=findOne_('Schools','SchoolID',id);if(!existing)return apiError_('Sekolah tidak ditemukan.','SCHOOL_NOT_FOUND');const result=validateSchool_(payload);if(!result.valid)return apiError_(result.errors[0],'VALIDATION_ERROR');const data=result.data,duplicate=readTable_('Schools').some(item=>item.SchoolID!==id&&data.npsn&&String(item.NPSN)===data.npsn);if(duplicate)return apiError_('NPSN sudah terdaftar.','DUPLICATE_NPSN');updateRecord_('Schools','SchoolID',id,{NamaSekolah:data.name,NPSN:data.npsn,Jenis:data.type,Alamat:data.address,Kecamatan:data.district,Status:data.status,UpdatedAt:nowIso_()});logActivity_(admin.user.UserID,'ADMIN_UPDATE','Schools',id,'Memperbarui sekolah','');return apiSuccess_({},'Sekolah berhasil diperbarui.');}catch(error){return apiError_(error.message,error.publicCode||'SCHOOL_UPDATE_FAILED');}}
