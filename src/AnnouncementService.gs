function validateAnnouncement_(payload){const data=payload||{},clean={title:sanitizeText_(data.title,180),content:sanitizeMultiline_(data.content,5000),audience:sanitizeText_(data.audience||'ALL',20).toUpperCase(),status:sanitizeText_(data.status||'DRAFT',20).toUpperCase(),expiresAt:sanitizeText_(data.expiresAt,10)},errors=[];if(clean.title.length<4)errors.push('Judul pengumuman minimal 4 karakter.');if(clean.content.length<10)errors.push('Isi pengumuman minimal 10 karakter.');if(['ALL','STUDENT','ADMIN'].indexOf(clean.audience)<0)errors.push('Audience tidak valid.');if(['DRAFT','PUBLISHED','ARCHIVED'].indexOf(clean.status)<0)errors.push('Status pengumuman tidak valid.');if(clean.expiresAt&&!isIsoDate_(clean.expiresAt))errors.push('Tanggal kedaluwarsa tidak valid.');return {valid:!errors.length,errors:errors,data:clean};}
function announcementRecord_(data,id,existing){const timestamp=nowIso_();return {AnnouncementID:id,Title:data.title,Content:data.content,Audience:data.audience,Status:data.status,PublishedAt:data.status==='PUBLISHED'?(existing&&existing.PublishedAt||timestamp):existing&&existing.PublishedAt||'',ExpiresAt:data.expiresAt,CreatedAt:existing&&existing.CreatedAt||timestamp,UpdatedAt:timestamp};}
function listAnnouncements(adminToken){try{requireSession_(adminToken,['ADMIN','SUPERADMIN']);return apiSuccess_({announcements:readTable_('Announcements').sort((a,b)=>String(b.UpdatedAt).localeCompare(String(a.UpdatedAt)))});}catch(error){return apiError_(error.message,error.publicCode||'ANNOUNCEMENTS_FAILED');}}
function createAnnouncement(adminToken,payload){try{const admin=requireSession_(adminToken,['ADMIN','SUPERADMIN']),result=validateAnnouncement_(payload);if(!result.valid)return apiError_(result.errors[0],'VALIDATION_ERROR');const id=generateId_('Announcements');appendRecords_('Announcements',[announcementRecord_(result.data,id,null)]);logActivity_(admin.user.UserID,'ADMIN_UPDATE','Announcements',id,'Membuat pengumuman','');return apiSuccess_({announcementId:id},'Pengumuman berhasil dibuat.');}catch(error){return apiError_(error.message,error.publicCode||'ANNOUNCEMENT_CREATE_FAILED');}}
function updateAnnouncement(adminToken,announcementId,payload){try{const admin=requireSession_(adminToken,['ADMIN','SUPERADMIN']),id=sanitizeText_(announcementId,40),existing=findOne_('Announcements','AnnouncementID',id);if(!existing)return apiError_('Pengumuman tidak ditemukan.','ANNOUNCEMENT_NOT_FOUND');const result=validateAnnouncement_(payload);if(!result.valid)return apiError_(result.errors[0],'VALIDATION_ERROR');updateRecord_('Announcements','AnnouncementID',id,announcementRecord_(result.data,id,existing));logActivity_(admin.user.UserID,'ADMIN_UPDATE','Announcements',id,'Memperbarui pengumuman','');return apiSuccess_({},'Pengumuman berhasil diperbarui.');}catch(error){return apiError_(error.message,error.publicCode||'ANNOUNCEMENT_UPDATE_FAILED');}}
function setAnnouncementStatus(adminToken,announcementId,status){try{const admin=requireSession_(adminToken,['ADMIN','SUPERADMIN']),id=sanitizeText_(announcementId,40),value=sanitizeText_(status,20).toUpperCase();if(['DRAFT','PUBLISHED','ARCHIVED'].indexOf(value)<0)return apiError_('Status tidak valid.','VALIDATION_ERROR');const item=findOne_('Announcements','AnnouncementID',id);if(!item)return apiError_('Pengumuman tidak ditemukan.','ANNOUNCEMENT_NOT_FOUND');updateRecord_('Announcements','AnnouncementID',id,{Status:value,PublishedAt:value==='PUBLISHED'?(item.PublishedAt||nowIso_()):item.PublishedAt,UpdatedAt:nowIso_()});logActivity_(admin.user.UserID,'ADMIN_UPDATE','Announcements',id,'Status pengumuman menjadi '+value,'');return apiSuccess_({},'Status pengumuman diperbarui.');}catch(error){return apiError_(error.message,error.publicCode||'ANNOUNCEMENT_STATUS_FAILED');}}
